# Clave de la API de Claude (Anthropic). Consíguela en https://console.anthropic.com
# En Vercel: Project Settings → Environment Variables → añade ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-...

# (Opcional) Modelo a usar. Por defecto: claude-sonnet-5
# Puedes subirlo a claude-opus-4-8 si quieres máxima calidad (más caro).
# ANTHROPIC_MODEL=claude-sonnet-5
